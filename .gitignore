# Astro's generated types and build cache
.astro/

# Astro's build output. This is the deployable artifact and there is exactly one
# copy of it: `tools/publish.mjs` no longer mirrors it to the repo root, so a
# rebuild always starts from a clean `out/`.
out/

# Built copies left at the repo root by the old publish step. The artifact lives
# in out/ now, so a root index.html or assets/ could only ever be stale.
/index.html
/assets/

