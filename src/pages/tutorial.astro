    <script>
        const io = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(elm => io.observe(elm));

        // System Tabs Logic
        const tabs = document.querySelectorAll('.sys-tab');
        const panels = {
            race: document.getElementById('panel-race'),
            window: document.getElementById('panel-window'),
            shoot: document.getElementById('panel-shoot')
        };

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const target = tab.dataset.tab;
                tabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                tab.classList.add('active');
                tab.setAttribute('aria-selected', 'true');

                Object.keys(panels).forEach(key => {
                    if (panels[key]) {
                        panels[key].style.display = (key === target) ? 'block' : 'none';
                        if (key === target) {
                            panels[key].classList.add('active');
                        }
                    }
                });
            });
        });
    </script>
