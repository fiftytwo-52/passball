---
import '../styles/tokens.css';
import '../styles/game.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#171717">

    <title>Guess & Pass — real-time 6-a-side</title>
    <meta name="description"
        content="Two two-minute halves of continuous 6-a-side football on a top-view pitch. Pass, shoot and dive in real time — every interception and save is won by geometry, not dice.">

    <meta property="og:type" content="website">
    <meta property="og:title" content="Guess & Pass">
    <meta property="og:description"
        content="Continuous real-time football: two 2-minute halves, and a penalty shootout if it's level. Nothing is resolved by dice — the ball is faster than the players, and that race is the game.">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23171717'/%3E%3Ccircle cx='16' cy='16' r='6.5' fill='none' stroke='%2350e3c2' stroke-width='2.5'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Anton is the start screen's display face and Rajdhani its body face —
         the match-day-programme voice the landing surface speaks in. The rest of
         the app stays on Geist, so these two load alongside it rather than
         replacing it. -->
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Rajdhani:wght@500;600;700&display=swap">
</head>

<body>
    <noscript>
        <div class="card card-floating" style="position:fixed;inset:auto 16px 16px 16px;z-index:99">
            <div class="eyebrow">Needs JavaScript</div>
            <h3>This is a real-time game</h3>
            <p>Guess & Pass renders a WebGL pitch and simulates the ball in the browser. Enable JavaScript to play.
            </p>
        </div>
    </noscript>

    <!--  ======================= APP SHELL =======================
          The pitch is the whole screen. Everything else is an anchored,
          pointer-events:none overlay floating above the turf, so the chrome can
          never push the ground around — at any viewport it either sits in a
          corner or it is scrolled/hidden (game-ui-ux: anchors + containers).

          Four anchors carry the live match state:
            · top-left   — the scoreline, on its own;
            · top-right  — the match clock, and the floating menu under it;
            · top-centre — the role + possession read-out, hung on the band
                           behind the far (computer's) goal; the shootout strip
                           shares the band while penalties are live;
            · bottom     — the two actions in the corners, the transient banner,
                           the short instruction line, which reads from the
                           strip behind the near goal, and the decision-window
                           ring, centred on the pitch centre circle and sized
                           from the camera fit. -->
    <div id="app">
        <section id="stage">
            <!-- One WebGL canvas: 3D characters standing on a 2D top-view board.
                 The pitch sits directly behind the camera centre, which is what
                 lets the decision ring be positioned with one transform. -->
            <canvas id="scene" aria-label="Football pitch, top-down view with 3D players"></canvas>

            <!-- ============================== HUD (TOP) ==============================
                 One capsule, borrowed whole from the START SCREEN's nav: the
                 scoreline, the role + possession pair, the half clock and the
                 menu all sit inside the same turf-lined pill, so the top band
                 reads as ONE object instead of three flotillas sharing a row.

                 The capsule is the only child of #hud-top, because the two halves
                 of the anchoring are split between them: the header owns the safe
                 area and the gutter, the capsule owns the chrome. That is what
                 makes the capsule line up exactly with the two things that drop
                 below it — the shootout strip and the menu sheet, both offset
                 from the stage by `--hud-bar-h`.

                 Nothing here is ever polled per frame: the score is written on
                 the `score` event, the clock only when the displayed second
                 changes.

                 NOTE: `#role-strip` is engine-bound — `game-source.js` owns its
                 `.hidden`, and the shootout swap is the only thing that flips it
                 — so it moved inside the capsule rather than being replaced by
                 it. And `#clock` must stay EXACTLY two levels above the element
                 that receives `.low`: the engine writes that class to
                 `#clock.parentElement.parentElement`, which here is `.clock-wrap`. -->
            <header id="hud-top" hidden>
                <div class="hud-capsule">
                    <!-- NOTE: the engine assigns `.textContent` on #score-you and
                         #score-cpu outright, so neither may wrap a <strong>. The
                         team colour is carried by the span itself instead. -->
                    <div class="score-mini" aria-label="Score">
                        <span class="sc sc-you" id="score-you">0</span>
                        <span class="sc-dash" aria-hidden="true">–</span>
                        <span class="sc sc-cpu" id="score-cpu">0</span>
                    </div>

                    <!-- Which end you are playing toward, and whose ball it is —
                         the two facts that decide the next prompt. It sits
                         between the scoreline and the clock so the eye reads
                         score · situation · time straight across the capsule.

                         NOTE: the engine assigns #role-badge.className and
                         #possession-chip.className outright, so neither carries
                         any other class — `.attack`/`.defend` and
                         `.chip you`/`.chip cpu` are the only states they can be
                         in. -->
                    <div id="role-strip" hidden>
                        <div class="status-row">
                            <span id="role-badge" class="attack">ATTACK</span>
                            <span id="possession-chip" class="chip you"><i class="dot"></i>YOU</span>
                        </div>
                    </div>

                    <!-- The half, the clock, and the hairline that drains as the
                         half runs out — three lines inside one field, because the
                         capsule has the height for it. -->
                    <div class="clock-wrap" id="clock-wrap">
                        <span class="clock-half" id="half-label">HALF 1</span>
                        <!-- role=timer implies aria-live=off: the countdown ticks every
                             second and must not be announced each tick. -->
                        <div class="clock-row">
                            <span id="clock" role="timer" class="clock-num">2:00</span>
                            <span id="clock-extra" class="clock-extra" hidden>+1s</span>
                        </div>
                        <span class="clock-line"><span id="clock-bar"></span></span>
                    </div>

                    <!-- The floating menu. Everything the match does not need on
                         screen lives in here so a phone shows the pitch and
                         almost nothing else. -->
                    <button type="button" class="hud-icon-btn" id="btn-menu-open" aria-expanded="false"
                        aria-controls="menu-sheet" title="Menu" aria-label="Open menu">☰</button>
                </div>
            </header>

            <!-- ===================== HUD (SHOOTOUT STRIP) =====================
                 §8/§10 — while a shootout is live the HUD swaps into this view:
                 kicker order, a separate shootout score, and whose turn it is.
                 It is pure read-out, so it stays a strip across the top centre. -->
            <section id="hud-pens" hidden aria-label="Penalty shootout">
                <span class="panel panel-pens">
                    <span class="hud-label" id="so-title">PENALTIES</span>
                    <span class="pens-score" id="so-score" aria-live="polite">0 – 0</span>
                </span>

                <span class="panel pens-order">
                    <span class="hud-label">You</span>
                    <span class="pens-dots" id="so-you"></span>
                </span>

                <span class="panel pens-order">
                    <span class="hud-label">Cpu</span>
                    <span class="pens-dots" id="so-cpu"></span>
                </span>

                <span class="panel panel-pens" id="so-turn">YOUR KICK</span>
            </section>

            <!-- ============================== DECISION RING ==============================
                 §17.b — the decision window, drawn ON the painted centre circle. No
                 numerals on screen: the arc draining is the whole read-out. The label
                 and the countdown stay in the DOM for screen readers, which is also
                 what the engine writes to.

                 This is a DIRECT CHILD OF #stage, not a child of #hud-bottom. The
                 stage is the full-viewport box, so `left:50%;top:50%` resolves to the
                 canvas centre — which is exactly where the camera puts game (50,50),
                 the centre circle. Nested inside the bottom bar instead, the same
                 50%/50% would resolve against that bar and the ring would sit under
                 the pitch. Its diameter is written to --ring-d by fitView(). -->
            <div class="panel-plan" id="plan-panel" hidden aria-label="Decision window">
                <span class="sr-only" id="plan-state">PLANNING</span>
                <span class="sr-only" id="plan-clock" role="timer">10</span>
                <svg class="ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                    <circle class="ring-track" cx="50" cy="50" r="46"></circle>
                    <circle class="ring-fill" id="plan-bar" cx="50" cy="50" r="46" pathLength="1"></circle>
                </svg>
            </div>

            <!-- ============================== HUD (BOTTOM) ==============================
                 The two controls in the CORNERS, the transient banner, and — last
                 in the bar, so it lands on the bottom-centre band behind the near
                 goal — the short instruction line.

                 The controls deliberately do NOT sit in the bottom centre. Both
                 goals are painted on the board's vertical centre line, so a
                 bottom-centre *row of controls* lands straight on the near goal
                 mouth — which is exactly where MOVES DONE and SHOOT used to sit.
                 MOVES DONE takes the left corner and SHOOT the right; `game.css`
                 pins them with a two-track grid so each keeps its corner even when
                 the other is hidden.

                 Only the guide line takes the centre, and only because it is the
                 one layer that should read as painted on the goal rather than laid
                 over the play. Being the final flex item, it self-centres at any
                 width without a single pixel being pinned. -->
            <footer id="hud-bottom" hidden>
                <div class="hud-actions">
                    <!-- Closes the window for the human. The CPU also has to be
                         ready: if it has stacked its moves and you have not, the
                         board stays frozen until you do. -->
                    <button type="button" class="btn btn-done" id="btn-done" title="Lock in your moves (Enter)"
                        hidden>MOVES DONE</button>

                    <!-- The one action worth a button, and it sits in the RIGHT
                         corner, clear of the goal mouth. Disabled and dimmed until
                         the human is on the ball and inside range, so it doubles as
                         the range indicator. Space and S fire it from the
                         keyboard. -->
                    <button type="button" class="btn btn-shoot" id="btn-shoot"
                        title="Shoot along the drawn angle (S or Space)"
                        aria-label="Shoot along the drawn angle" disabled>
                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="9.1" fill="none" stroke="currentColor" stroke-width="1.7" />
                            <circle cx="12" cy="12" r="3.9" fill="currentColor" />
                            <path d="M12 1.6v3.1M12 19.3v3.1M1.6 12h3.1M19.3 12h3.1"
                                stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                        <span class="ico-label">SHOOT</span>
                    </button>
                </div>

                <div id="banner" aria-live="polite"></div>

                <!-- The guide line closes the bar so its own centre is the stage's
                     bottom-centre: the strip behind the near goal, clear of both
                     corner controls and of the play. -->
                <p id="instruction">Stack your moves, then press MOVES DONE.</p>
            </footer>

            <!-- the goal celebration: a word bursting off the turf, over the pitch -->
            <div id="goal-fx" aria-hidden="true"><span id="goal-fx-word">GOAL</span></div>

            <!-- The floating menu sheet. Buttons only — the match keeps running
                 underneath, so this is a dropdown and not a screen. -->
            <div class="sheet-scrim" id="sheet-scrim" hidden></div>
            <div class="hud-sheet" id="menu-sheet" hidden role="dialog" aria-label="Menu">
                <div class="sheet-head">
                    <span class="hud-label">Menu</span>
                    <button type="button" class="btn btn-icon-xs" id="btn-menu-close" aria-label="Close menu">✕</button>
                </div>

                <div class="sheet-rows">
                    <button type="button" class="btn sheet-row" id="btn-help">HOW TO PLAY</button>
                    <button type="button" class="btn sheet-row" id="btn-mute" aria-pressed="false" title="Mute (M)"
                        aria-label="Mute sound"><span>Sound</span><span class="sheet-val">ON</span></button>
                    <button type="button" class="btn sheet-row" id="btn-pause" title="Pause (Esc)"
                        aria-label="Pause match"><span>Pause</span><span class="sheet-val">❙❙</span></button>
                    <button type="button" class="btn sheet-row" id="btn-menu-restart"><span>Restart match</span><span
                            class="sheet-val">↻</span></button>
                    <button type="button" class="btn sheet-row sheet-row-danger"
                        id="btn-menu-quit"><span>Quit to menu</span><span class="sheet-val">⏻</span></button>
                </div>
            </div>
        </section>
    </div>

    <!-- ============================== START SCREEN ==============================
         The landing surface is the pitch itself, dressed as a match-day
         programme in the app's own kit: a nav capsule (brand, the two tags the
         match is played under, and the utility row), a hero carrying the side's
         2:3:1 shape, and a control capsule that ends in the kick-off CTA. Those
         are three flex zones inside one frame — never absolute pixels — so at a
         wide width the same components flatten into rows (game-ui-ux: anchors +
         containers).

         The engine binds every id below; read the DOM contract note at the top
         of `game.css` before renaming anything:
           #btn-start    → beginMatch()            (focused on every menu entry)
           #btn-penalty  → beginShootout()
           #btn-tutorial → pushScreen('tutorial')
           #btn-verify   → the rulebook self-test, mirrored into #verify-out
           #difficulty-start / #plan-window-start / #half-length-start /
           #sound-start  → the four `.segmented` groups the engine syncs.
         #menu-title is the dialog's accessible name.

         The quick strip is those same four groups drawn as one scrollable row of
         chips instead of four labelled rows: the engine still owns every pill and
         every aria-pressed, so there is no second copy of a setting to drift. -->
    <div class="screen" id="screen-menu">
        <!-- Weathering: a vignette to settle the turf at its edges, and fine grain so
             the large flat fills do not band on a wide-gamut panel. Both are
             decorative, so neither may take a pointer event. -->
        <div class="vignette" aria-hidden="true"></div>
        <div class="grain" aria-hidden="true"></div>

        <div class="menu-frame" role="dialog" aria-modal="true" aria-labelledby="menu-title">
            <div class="navbar">
                <div class="top-capsule">
                    <div class="brand-row">
                        <svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 6l3.5 2.6-1.3 4h-4.4l-1.3-4z" />
                        </svg>
                        <span class="brand-name">Passball</span>
                    </div>

                    <div class="caps-row primary">
                        <span class="cap tag">Guess & Pass</span>
                        <span class="cap">6-a-side</span>
                    </div>

                    <!-- The utility row. Tutorial and the rulebook self-test open a
                         real in-app surface; the three pills that *describe* the
                         project have no screen to open, so they hand the player to
                         the browser rather than pretending to be one. -->
                    <div class="caps-row utility">
                        <button type="button" class="btn cap" id="btn-tutorial">Tutorial</button>
                        <a class="cap" href="https://passball.pages.dev/">About us</a>
                        <a class="cap" href="mailto:ganeshkhatiwada071@gmail.com">Contact</a>
                        <a class="cap" href="https://passball.pages.dev/">Privacy policy</a>
                        <button type="button" class="btn cap" id="btn-verify">Rulebook tests</button>
                    </div>
                </div>
            </div>

            <section class="hero" aria-label="About the match">
                <div class="vs">Your shape · 2 : 3 : 1</div>

                <!-- The shape the side actually lines up in: six amber outfielders
                     in their own half, three sage opponents in theirs. -->
                <svg class="pitch" viewBox="0 0 160 240" aria-hidden="true" focusable="false">
                    <rect x="4" y="4" width="152" height="232" rx="8" fill="none" stroke="#3A5C46" stroke-width="2" />
                    <line x1="4" y1="120" x2="156" y2="120" stroke="#3A5C46" stroke-width="2" />
                    <circle cx="80" cy="120" r="22" fill="none" stroke="#3A5C46" stroke-width="2" />
                    <rect x="45" y="4" width="70" height="28" fill="none" stroke="#3A5C46" stroke-width="2" />
                    <rect x="45" y="208" width="70" height="28" fill="none" stroke="#3A5C46" stroke-width="2" />
                    <circle cx="80" cy="205" r="6" fill="#F2A63C" />
                    <circle cx="40" cy="170" r="6" fill="#F2A63C" />
                    <circle cx="120" cy="170" r="6" fill="#F2A63C" />
                    <circle cx="28" cy="132" r="6" fill="#F2A63C" />
                    <circle cx="132" cy="132" r="6" fill="#F2A63C" />
                    <circle cx="80" cy="142" r="6" fill="#F2A63C" />
                    <circle cx="80" cy="34" r="6" fill="#8CA394" />
                    <circle cx="45" cy="66" r="6" fill="#8CA394" />
                    <circle cx="115" cy="66" r="6" fill="#8CA394" />
                </svg>

                <div class="hero-copy">
                    <div class="eyebrow">Your shape · 2 : 3 : 1</div>
                    <h1 id="menu-title">Guess & Pass</h1>
                    <p>Freeze the board on every change of possession, stack your moves, then watch both sides play
                        them out.</p>
                </div>
            </section>

            <div class="bottom-area">
                <section class="settings-capsule" aria-label="Match settings">
                    <!-- Read-out, not a control. The engine plays the CPU and has no
                         second human seat, so the pair reports which mode is live and
                         marks PvP SOON rather than offering a switch that would do
                         nothing when pressed. -->
                    <div class="mode-switch">
                        <div class="mode active" aria-current="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                aria-hidden="true" focusable="false">
                                <rect x="4" y="4" width="16" height="12" rx="1.5" />
                                <path d="M9 20h6M12 16v4" />
                            </svg>
                            Vs computer
                        </div>
                        <div class="mode" title="Two-player is not built yet">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                aria-hidden="true" focusable="false">
                                <circle cx="8" cy="8" r="3" />
                                <circle cx="16" cy="8" r="3" />
                                <path d="M3 20c0-3 2.5-5 5-5s5 2 5 5M11 20c0-3 2.5-5 5-5s5 2 5 5" />
                            </svg>
                            PvP <span class="soon">soon</span>
                        </div>
                    </div>

                    <!-- The four groups the in-game menu sheet also edits, drawn once
                         here as one scrollable strip of chips. Each chip carries its
                         own group, so the pressed pill is the value and the engine's
                         sync keeps both surfaces identical. -->
                    <div class="quick">
                        <div class="qchip">
                            <span class="qchip-label">Difficulty</span>
                            <div class="segmented segmented-num" id="difficulty-start" role="group"
                                aria-label="Difficulty">
                                <button type="button" class="btn" data-diff="0.35" aria-pressed="false">LOW</button>
                                <button type="button" class="btn" data-diff="0.75" aria-pressed="true">MID</button>
                                <button type="button" class="btn" data-diff="1.25" aria-pressed="false">HARD</button>
                                <button type="button" class="btn" data-diff="1.85" aria-pressed="false">EXTREME</button>
                            </div>
                        </div>

                        <div class="qchip">
                            <span class="qchip-label">Timer</span>
                            <div class="segmented segmented-num" id="plan-window-start" role="group"
                                aria-label="Move timer seconds">
                                <button type="button" class="btn" data-lock="3" aria-pressed="false">3s</button>
                                <button type="button" class="btn" data-lock="5" aria-pressed="false">5s</button>
                                <button type="button" class="btn" data-lock="10" aria-pressed="true">10s</button>
                                <button type="button" class="btn" data-lock="20" aria-pressed="false">20s</button>
                            </div>
                        </div>

                        <div class="qchip">
                            <span class="qchip-label">Length</span>
                            <div class="segmented segmented-num" id="half-length-start" role="group"
                                aria-label="Half length">
                                <button type="button" class="btn" data-half="60" aria-pressed="false">1:00</button>
                                <button type="button" class="btn" data-half="120" aria-pressed="true">2:00</button>
                                <button type="button" class="btn" data-half="180" aria-pressed="false">3:00</button>
                            </div>
                        </div>

                        <div class="qchip">
                            <span class="qchip-label">Sound</span>
                            <div class="segmented segmented-num" id="sound-start" role="group" aria-label="Sound">
                                <button type="button" class="btn" data-sound="on" aria-pressed="true">ON</button>
                                <button type="button" class="btn" data-sound="off" aria-pressed="false">OFF</button>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="cta-stack">
                    <button type="button" class="btn kickoff" id="btn-start">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"
                            aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 7l4 3-1.5 4.5h-5L8 10z" />
                            <path d="M12 2v5M2.5 9l4 1.5M4 18l4-3M20 18l-4-3M21.5 9l-4 1.5" />
                        </svg>
                        Kick off
                    </button>
                    <button type="button" class="btn kickoff-alt" id="btn-penalty">Penalty shootout</button>
                </div>

                <div class="test-result" id="verify-out" aria-live="polite" hidden></div>
            </div>

            <!-- The phone's home-indicator stand-in: it gives the bottom of a tall
                 screen a floor. Hidden once the layout is a desktop row. -->
            <div class="homebar" aria-hidden="true"></div>
        </div>
    </div>

    <div class="screen" id="screen-tutorial" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="tut-title">
            <div class="eyebrow">How to play</div>
            <h2 id="tut-title">Stack your moves, then watch them play out</h2>

            <ul class="spec-list">
                <li><strong>Your end</strong> — <strong>you defend the BOTTOM goal and attack the TOP one.</strong>
                    Six a side: your keeper and five outfielders all start in your own half, so you always play
                    away from yourself.</li>
                <li><strong>The decision window</strong> — the moment either side wins the ball, the board freezes and
                    the ring in the centre circle starts draining. Nothing moves until it empties. You
                    stack <em>as many moves as you like</em> in that time; they all resolve together.</li>
                <li><strong>The pass</strong> — <em>drag from the ball-carrier onto a team-mate</em> to pass to them,
                    or <em>into empty space</em> to play it there. Anyone can receive, keeper included. The ball is
                    led into a team-mate's run, so a pass to a moving player meets them on the way.</li>
                <li><strong>The runs</strong> — <em>drag any of your players</em> to drop a ring where they should be
                    when the ball is played. Stack as many runners as you have players.</li>
                <li><strong>The shot</strong> — inside 30 units of goal, press <strong>SHOOT</strong> (or
                    <span class="keyhint">Space</span>, or double-tap the goal mouth) to stack a shot. The keeper
                    commits to a side, so <strong>aim across him</strong> — the far post is open. Outside that
                    range the button does nothing.</li>
                <li><strong>The save</strong> — defending, <em>drag your keeper to the dive point</em> to stack the
                    save. Leave it and the keeper dives on their own read.</li>
                <li><strong>Closing the window</strong> — press <strong>MOVES DONE</strong> (or
                    <span class="keyhint">Enter</span>). The CPU has to be ready too: if it has finished and you
                    have not, the board <em>stays frozen</em>. If you give no instruction at all, your side plays a
                    random pass.</li>
                <li><strong>The race</strong> — a pass only belongs to you if <em>the nearest player to the ball is
                    yours</em> when it lands. Send the wrong man and it spills loose, and the closest body from
                    either side goes for it. Whoever wins it opens the next window.</li>
                <li><strong>Keyboard</strong> — <span class="keyhint">Space</span> shoot ·
                    <span class="keyhint">Enter</span> moves done · <span class="keyhint">Esc</span> pause ·
                    <span class="keyhint">M</span> mute · <span class="keyhint">R</span> restart match.</li>
                <li><strong>Penalties</strong> — level at full time, press <strong>GO TO PENALTIES</strong>. Draw the aim
                    line, then draw the dive line: within the keeper's reach it is saved, otherwise it is a goal.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-tut-close">GOT IT</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-pause" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="pause-title">
            <div class="eyebrow">Paused</div>
            <h2 id="pause-title">Time out</h2>
            <p>The match clock is paused too — it resumes exactly where it stopped.</p>

            <ul class="spec-list">
                <li><strong>1 · Stack the pass</strong> — <em>drag from the ball-carrier</em> onto a team-mate to
                    pass to them, or into space to play it into an area.</li>
                <li><strong>2 · Send the runners</strong> — <em>drag your players</em> to drop a ring where each of
                    them should be when the ball is played.</li>
                <li><strong>3 · Set the finish</strong> — inside range, press <strong>SHOOT</strong> to stack a shot;
                    defending, <em>drag your keeper</em> to the dive point.</li>
                <li><strong>4 · Close the window</strong> — press <strong>MOVES DONE</strong>. Both sides' moves then
                    resolve at once — nothing here happens one move at a time.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-resume">RESUME</button>
                <button type="button" class="btn btn-secondary" id="btn-restart">RESTART MATCH</button>
                <button type="button" class="btn btn-ghost-sm" id="btn-quit">QUIT TO MENU</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-halftime" hidden>
        <div class="card card-halftime" role="dialog" aria-modal="true" aria-labelledby="half-title">
            <div class="eyebrow">Interval</div>
            <h2 id="half-title">Halftime</h2>
            <div class="halftime-score-banner" aria-label="Current score">
                <span class="sc sc-you" id="half-score-you">0</span>
                <span class="sc-dash" aria-hidden="true">–</span>
                <span class="sc sc-cpu" id="half-score-cpu">0</span>
            </div>
            <p id="half-detail">First half concluded. Ready for the second half?</p>

            <div class="actions">
                <button type="button" class="btn btn-primary btn-xl" id="btn-half-continue">CONTINUE TO SECOND HALF</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-over" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="over-title">
            <div class="eyebrow">Full time</div>
            <h2 id="over-title">—</h2>
            <p id="over-detail"></p>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-pens" hidden>GO TO PENALTIES</button>
                <button type="button" class="btn btn-secondary" id="btn-again">PLAY AGAIN</button>
                <button type="button" class="btn btn-ghost-sm" id="btn-menu">MAIN MENU</button>
            </div>
        </div>
    </div>

    <div id="err" role="alert"></div>

    <!-- Portrait gate (mobile/touch only): shown over everything — game and
         menus alike — when a touch device is held in landscape. The engine
         owns its `hidden`; see the orientation guard in game-source.js. -->
    <div id="rotate-gate" hidden role="alertdialog" aria-modal="true" aria-labelledby="rotate-title"
        aria-describedby="rotate-detail">
        <div class="rotate-card">
            <svg class="rotate-phone" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <rect class="rg-body" x="22" y="10" width="20" height="36" rx="4" />
                <line class="rg-home" x1="29" y1="41" x2="35" y2="41" />
                <path class="rg-arc" d="M47 14 A22 22 0 0 1 52 38" fill="none" />
                <path class="rg-arrow" d="M52 31 L52 39 L45 37 Z" />
            </svg>
            <h2 id="rotate-title">Rotate your device</h2>
            <p id="rotate-detail">This match is portrait-only. Turn your phone upright to keep playing.</p>
        </div>
    </div>

    <!-- Three.js is bundled from node_modules by Vite (no CDN dependency). -->
    <script>
        import '../scripts/game-source.js';

        /* The engine's rulebook self-test logs a table and stashes the report on
           window.__GAP_VERIFY_RESULTS. Mirror that verdict into the menu card so
           it is legible without opening devtools — the engine stays the sole
           authority on pass/fail; this only renders what it reported.

           Registration order matters and is safe: importing the engine above
           synchronously installs its own click handler first, so by the time this
           listener runs the report has already been refreshed. */
        const verifyOut = document.getElementById('verify-out');
        const verifyBtn = document.getElementById('btn-verify');

        if (verifyOut && verifyBtn) {
            verifyBtn.addEventListener('click', () => {
                const report = window.__GAP_VERIFY_RESULTS;
                if (!report) {
                    verifyOut.textContent = 'No report available — reload the page and try again.';
                    verifyOut.hidden = false;
                    return;
                }

                const failed = report.results.filter(r => !r.pass);
                const head = (report.allPass ? 'ALL PASS · ' : 'FAILURES · ')
                    + report.properties + ' properties';
                const body = failed.length
                    ? failed.map(r => 'FAIL  ' + r.name + (r.detail ? '\n      ' + r.detail : '')).join('\n')
                    : 'Every property held — the resolution races agree with the geometry.';

                verifyOut.textContent = head + '\n' + body;
                verifyOut.hidden = false;
            });
        }
    </script>
</body>

</html>
