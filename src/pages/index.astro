---
import '../styles/tokens.css';
import '../styles/game.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#171717">

    <title>Guess & Pass — real-time 6-a-side</title>
    <meta name="description"
        content="Two two-minute halves of continuous 6-a-side football on a top-view pitch. Pass, shoot and dive in real time — every interception and save is won by geometry, not dice.">

    <meta property="og:type" content="website">
    <meta property="og:title" content="Guess & Pass">
    <meta property="og:description"
        content="Continuous real-time football: two 2-minute halves, and a penalty shootout if it's level. Nothing is resolved by dice — the ball is faster than the players, and that race is the game.">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23171717'/%3E%3Ccircle cx='16' cy='16' r='6.5' fill='none' stroke='%2350e3c2' stroke-width='2.5'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
</head>

<body>
    <noscript>
        <div class="card card-floating" style="position:fixed;inset:auto 16px 16px 16px;z-index:99">
            <div class="eyebrow">Needs JavaScript</div>
            <h3>This is a real-time game</h3>
            <p>Guess & Pass renders a WebGL pitch and simulates the ball in the browser. Enable JavaScript to play.
            </p>
        </div>
    </noscript>

    <!--  ======================= APP SHELL =======================
          A column of stacked bands: top dock / stage / shootout strip / bottom dock.
          The docks are flow siblings of the stage rather than overlays, so at any
          viewport size they can only ever push the pitch smaller — never cover
          it. The turf carries the players and the ball and nothing else.  -->
    <div id="app">
        <!-- ============================== HUD (TOP) ==============================
             Identity on the left, clock and controls on the right. The clock is
             written only when the displayed second changes — the HUD is never
             polled per frame. -->
        <header id="hud-top" hidden>
            <div class="dock">
                <div class="cluster">
                    <!-- NOTE: the engine assigns #role-badge.className outright, so it
                         carries no other class. Same for #possession-chip. -->
                    <span id="role-badge" class="attack">ATTACK</span>
                    <span id="possession-chip" class="chip you"><i class="dot"></i>YOU · BALL</span>

                    <span class="panel scoreboard" aria-label="Score">
                        <span class="score" id="score-you"><strong>0</strong><span class="hud-label">You</span></span>
                        <span class="vs">VS</span>
                        <span class="score" id="score-cpu"><strong>0</strong><span class="hud-label">Cpu</span></span>
                    </span>

                    <span class="panel panel-clock" aria-label="Match clock">
                        <span class="clock-line">
                            <span class="hud-label" id="half-label">HALF 1</span>
                            <!-- role=timer implies aria-live=off: the countdown ticks every
                                 second and must not be announced each tick. -->
                            <span id="clock" role="timer" class="clock-num">2:00</span>
                        </span>
                        <span class="clock-track"><span id="clock-bar"></span></span>
                    </span>
                </div>

                <div class="cluster">
                    <div class="segmented" id="difficulty" role="group" aria-label="CPU difficulty">
                        <button type="button" class="btn" data-diff="0.15" aria-pressed="false">COIN-FLIP</button>
                        <button type="button" class="btn" data-diff="0.6" aria-pressed="true">SHARP</button>
                        <button type="button" class="btn" data-diff="1" aria-pressed="false">RUTHLESS</button>
                    </div>

                    <!-- The one action worth a button: a shot at the goal. It is
                         disabled and dimmed until the human is actually on the
                         ball, inside range, in open play — so it doubles as the
                         range indicator. Kept first in this cluster, because on a
                         narrow screen the cluster scrolls sideways and this is
                         the control that must never be the one that scrolls off. -->
                    <button type="button" class="btn btn-shoot" id="btn-shoot" title="Shoot (S)"
                        aria-label="Shoot at goal" disabled>
                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="9.1" fill="none" stroke="currentColor" stroke-width="1.7" />
                            <circle cx="12" cy="12" r="3.9" fill="currentColor" />
                            <path d="M12 1.6v3.1M12 19.3v3.1M1.6 12h3.1M19.3 12h3.1"
                                stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                        <span class="ico-label">SHOOT</span>
                    </button>

                    <button type="button" class="btn btn-ghost-sm" id="btn-help">HOW TO PLAY</button>
                    <button type="button" class="btn btn-icon" id="btn-mute" aria-pressed="false" title="Mute (M)"
                        aria-label="Mute sound">♪</button>
                    <button type="button" class="btn btn-icon" id="btn-pause" title="Pause (Esc)"
                        aria-label="Pause">❙❙</button>
                </div>
            </div>
        </header>

        <!-- ========================= THE PITCH =========================
             One WebGL canvas: 3D characters standing on a 2D top-view board.
             The stage holds the canvas and nothing else. -->
        <section id="stage">
            <canvas id="scene" aria-label="Football pitch, top-down view with 3D players"></canvas>
        </section>

        <!-- ===================== HUD (SHOOTOUT STRIP) =====================
             §8/§10 — the HUD swaps into a shootout view for the duration of the
             shootout: kicker order, a separate shootout score, and whose turn it
             is. It is a flow band like the docks, so it also cannot cover the
             ground. The engine reveals it only while a shootout is live. -->
        <section id="hud-pens" hidden aria-label="Penalty shootout">
            <div class="dock">
                <div class="cluster">
                    <span class="panel panel-pens">
                        <span class="hud-label" id="so-title">PENALTIES</span>
                        <span class="pens-score" id="so-score" aria-live="polite">0 – 0</span>
                    </span>

                    <span class="panel pens-order">
                        <span class="hud-label">You</span>
                        <span class="pens-dots" id="so-you"></span>
                    </span>

                    <span class="panel pens-order">
                        <span class="hud-label">Cpu</span>
                        <span class="pens-dots" id="so-cpu"></span>
                    </span>
                </div>

                <div class="cluster">
                    <span class="panel panel-pens" id="so-turn">YOUR KICK</span>
                </div>
            </div>
        </section>

        <!-- ============================== HUD (BOTTOM) ==============================
             The rolling log and the instruction line. Nothing here is ever drawn
             over the pitch. -->
        <footer id="hud-bottom" hidden>
            <div class="dock">
                <div class="cluster">
                    <div class="panel" id="log-panel">
                        <span class="hud-label">Match log</span>
                        <ul id="log"></ul>
                    </div>
                    <p id="instruction">Draw a line from the ball-carrier into space and release to play the
                        pass — you attack the TOP goal.</p>
                </div>

                <div class="cluster">
                    <div id="banner" aria-live="polite"></div>
                </div>
            </div>
        </footer>
    </div>

    <!-- ============================== SCREENS ============================== -->
    <div class="screen" id="screen-menu">
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="menu-title">
            <div class="mesh mesh-wash" aria-hidden="true"></div>

            <div class="eyebrow">Phase 1 · Versus CPU</div>
            <h1 id="menu-title">Guess & Pass</h1>
            <p class="body-lg">Continuous real-time football. Six a side, two two-minute halves, no turns and no
                hidden windows — the ball is faster than any player, and that race is the whole game.</p>

            <ul class="spec-list">
                <li>Low-poly <strong>3D players</strong> standing on a <strong>2D top-view pitch</strong>.</li>
                <li>Two <strong>2:00 halves</strong>. Level at full time and you can settle it from the spot.</li>
                <li>Every pass and shot resolved by <strong>pure geometry</strong> — proximity races, never dice.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-start">KICK OFF</button>
                <button type="button" class="btn btn-secondary" id="btn-tutorial">TUTORIAL</button>
                <button type="button" class="btn btn-ghost-sm" id="btn-verify">RUN RULEBOOK TESTS</button>
            </div>

            <div class="test-result" id="verify-out" aria-live="polite" hidden></div>
        </div>
    </div>

    <div class="screen" id="screen-tutorial" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="tut-title">
            <div class="eyebrow">How to play</div>
            <h2 id="tut-title">Play it live — the ball is already moving</h2>

            <ul class="spec-list">
                <li><strong>Your end</strong> — <strong>you defend the BOTTOM goal and attack the TOP one.</strong>
                    Six a side: your keeper and five outfielders all start in your own half, so you always play
                    away from yourself.</li>
                <li><strong>On the ball</strong> — <em>draw a line from the ball-carrier into space</em> and
                    <em>release</em> to play the pass there. The ball goes <em>where you drew</em>, not to a
                    teammate's feet.</li>
                <li><strong>Moving off the ball</strong> — <em>drag the player who goes for the ball</em> to run them
                    onto the pass, then <em>drag the passer</em> to move them on after releasing.</li>
                <li><strong>Shooting</strong> — inside 30 units of goal, <em>double-tap a point along the goal mouth</em>
                    to shoot, or <em>drag one player towards the goal</em> to make a committed move. Outside that
                    range a double-tap does nothing.</li>
                <li><strong>Defending</strong> — <em>drag a defender</em> across the passing lane to intercept, or
                    <em>tap a teammate</em> to send them to a spot. The interceptor is live: the ball is cut out the
                    instant they get within reach of it.</li>
                <li><strong>In goal</strong> — when the CPU shoots, <em>drag or tap the dive point</em>. No input means a
                    default dive toward the shot's side.</li>
                <li><strong>Keyboard</strong> — <span class="keyhint">Esc</span> pause ·
                    <span class="keyhint">M</span> mute · <span class="keyhint">R</span> restart match.</li>
                <li><strong>Penalties</strong> — level at full time, press <strong>GO TO PENALTIES</strong>. Draw the aim
                    line, then draw the dive line: within the keeper's reach it is saved, otherwise it is a goal.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-tut-close">GOT IT</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-pause" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="pause-title">
            <div class="eyebrow">Paused</div>
            <h2 id="pause-title">Time out</h2>
            <p>The match clock is paused too — it resumes exactly where it stopped.</p>

            <ul class="spec-list">
                <li><strong>1 · Pass into space</strong> — <em>draw a line from the ball-carrier into space</em>,
                    then release. You are playing the ball <em>into an area</em>, not at a player.</li>
                <li><strong>2 · Send the runner</strong> — <em>drag the player who goes for the ball</em>, so they
                    chase the pass you just released.</li>
                <li><strong>3 · Follow the pass</strong> — <em>drag the passer</em> to move them after they have
                    released it.</li>
                <li><strong>4 · Make the move</strong> — <em>choose one player and drag them towards the goal</em> to
                    commit someone to the attack.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-resume">RESUME</button>
                <button type="button" class="btn btn-secondary" id="btn-restart">RESTART MATCH</button>
                <button type="button" class="btn btn-ghost-sm" id="btn-quit">QUIT TO MENU</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-over" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="over-title">
            <div class="eyebrow">Full time</div>
            <h2 id="over-title">—</h2>
            <p id="over-detail"></p>

            <div class="actions">
                <button type="button" class="btn btn-primary" id="btn-pens" hidden>GO TO PENALTIES</button>
                <button type="button" class="btn btn-secondary" id="btn-again">PLAY AGAIN</button>
                <button type="button" class="btn btn-ghost-sm" id="btn-menu">MAIN MENU</button>
            </div>
        </div>
    </div>

    <div id="err" role="alert"></div>

    <!-- Three.js is bundled from node_modules by Vite (no CDN dependency). -->
    <script>
        import '../scripts/game-source.js';

        /* The engine's rulebook self-test logs a table and stashes the report on
           window.__GAP_VERIFY_RESULTS. Mirror that verdict into the menu card so
           it is legible without opening devtools — the engine stays the sole
           authority on pass/fail; this only renders what it reported.

           Registration order matters and is safe: importing the engine above
           synchronously installs its own click handler first, so by the time this
           listener runs the report has already been refreshed. */
        const verifyOut = document.getElementById('verify-out');
        const verifyBtn = document.getElementById('btn-verify');

        if (verifyOut && verifyBtn) {
            verifyBtn.addEventListener('click', () => {
                const report = window.__GAP_VERIFY_RESULTS;
                if (!report) {
                    verifyOut.textContent = 'No report available — reload the page and try again.';
                    verifyOut.hidden = false;
                    return;
                }

                const failed = report.results.filter(r => !r.pass);
                const head = (report.allPass ? 'ALL PASS · ' : 'FAILURES · ')
                    + report.properties + ' properties';
                const body = failed.length
                    ? failed.map(r => 'FAIL  ' + r.name + (r.detail ? '\n      ' + r.detail : '')).join('\n')
                    : 'Every property held — the resolution races agree with the geometry.';

                verifyOut.textContent = head + '\n' + body;
                verifyOut.hidden = false;
            });
        }
    </script>
</body>

</html>
