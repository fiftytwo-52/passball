---
import '../styles/tokens.css';
import '../styles/game.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#171717">

    <title>Guess & Pass — decision-window football</title>
    <meta name="description"
        content="Three seconds to read the lane, commit the pass and break the pattern. Low-poly 3D players on a 2D top-view pitch, resolved by the canonical geometric + guess-bonus algorithm.">

    <meta property="og:type" content="website">
    <meta property="og:title" content="Guess & Pass">
    <meta property="og:description"
        content="Attacker and defender choose at the same time, hidden from each other. Three seconds to decide.">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23171717'/%3E%3Ccircle cx='16' cy='16' r='6.5' fill='none' stroke='%2350e3c2' stroke-width='2.5'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
</head>

<body>
    <noscript>
        <div class="card card-floating" style="position:fixed;inset:auto 16px 16px 16px;z-index:99">
            <div class="eyebrow">Needs JavaScript</div>
            <h3>This is a real-time game</h3>
            <p>Guess & Pass renders a WebGL pitch and resolves its passes in the browser. Enable JavaScript to play.
            </p>
        </div>
    </noscript>

    <!-- ========================= THE PITCH =========================
         One WebGL canvas: 3D characters standing on a 2D top-view board. -->
    <canvas id="scene" aria-label="Football pitch, top-down view with 3D players"></canvas>

    <!-- ============================== HUD ============================== -->
    <div id="hud" hidden>
        <div class="row row-top">
            <div class="cluster">
                <!-- NOTE: the engine assigns #role-badge.className outright, so it
                     carries no other class. Same for #possession-chip. -->
                <span id="role-badge" class="attack">ATTACK</span>
                <span id="possession-chip" class="chip you"><i class="dot"></i>YOU · BALL</span>

                <span class="panel scoreboard" aria-label="Score">
                    <span class="score" id="score-you"><strong>0</strong><span class="hud-label">You</span></span>
                    <span class="vs">VS</span>
                    <span class="score" id="score-cpu"><strong>0</strong><span class="hud-label">Cpu</span></span>
                </span>
            </div>

            <div class="cluster">
                <span class="panel panel-flush">
                    <span class="hud-label" id="plays">PLAY 1 / 24</span>
                    <span id="timer-num" class="tnum">3.0</span>
                </span>

                <div class="segmented" id="difficulty" role="group" aria-label="CPU difficulty">
                    <button type="button" data-diff="0.15" aria-pressed="false">COIN-FLIP</button>
                    <button type="button" data-diff="0.6" aria-pressed="true">SHARP</button>
                    <button type="button" data-diff="1" aria-pressed="false">RUTHLESS</button>
                </div>

                <button type="button" class="btn-icon" id="btn-mute" aria-pressed="false" title="Mute (M)"
                    aria-label="Mute sound">♪</button>
                <button type="button" class="btn-icon" id="btn-pause" title="Pause (Esc)" aria-label="Pause">❙❙</button>
            </div>
        </div>

        <div class="row row-center">
            <div class="panel panel-timer">
                <span class="hud-label">Decision window</span>
                <div id="timer-wrap"><span id="timer-bar"></span></div>
            </div>
        </div>

        <div class="row row-bottom">
            <div class="cluster">
                <div class="panel" id="log-panel">
                    <span class="hud-label">Match log</span>
                    <ul id="log"></ul>
                </div>
                <p id="instruction">Swipe from the carrier to a teammate to pass.</p>
            </div>

            <div class="cluster">
                <button type="button" class="btn-ghost-sm" id="btn-help">HOW TO PLAY</button>
                <button type="button" class="btn-primary-sm" id="btn-lock">LOCK IN ⏎</button>
            </div>
        </div>
    </div>

    <!-- ====================== FEEDBACK LAYERS ====================== -->
    <div id="banner" aria-live="polite"></div>
    <div id="flash"></div>

    <!-- ============================== SCREENS ============================== -->
    <div class="screen" id="screen-menu">
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="menu-title">
            <div class="mesh mesh-wash" aria-hidden="true"></div>

            <div class="eyebrow">Phase 1 · Versus CPU</div>
            <h1 id="menu-title">Guess & Pass</h1>
            <p class="body-lg">Read the lane. Commit the pass. Break the pattern. Three seconds to decide — attacker and
                defender choose at the same time, hidden from each other.</p>

            <ul class="spec-list">
                <li>Low-poly <strong>3D players</strong> standing on a <strong>2D top-view pitch</strong>.</li>
                <li>First to <strong>3 goals</strong> wins · hard cap of <strong>24 plays</strong>.</li>
                <li>Every pass resolved by the canonical <strong>geometric + guess-bonus</strong> algorithm (§4).</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn-primary" id="btn-start">KICK OFF</button>
                <button type="button" class="btn-secondary" id="btn-tutorial">TUTORIAL</button>
                <button type="button" class="btn-ghost-sm" id="btn-verify">RUN §4 VERIFICATION TESTS</button>
            </div>

            <div class="test-result" id="verify-out" aria-live="polite" hidden></div>
        </div>
    </div>

    <div class="screen" id="screen-tutorial" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="tut-title">
            <div class="eyebrow">How to play</div>
            <h2 id="tut-title">One window, two hidden choices</h2>

            <ul class="spec-list">
                <li><strong>Attacking</strong> — <em>swipe from the carrier</em> toward a teammate to pick the pass;
                    release on a teammate to commit early. <em>Drag a teammate</em> to move your runner, or tap a
                    teammate and then LOCK IN.</li>
                <li><strong>Defending</strong> — <em>drag a defender</em> outward to commit its guess direction; it
                    breaks that way the moment the ball is played.</li>
                <li><strong>Running out of time</strong> — everything is auto-filled at the end of the 3-second window:
                    the attacker gets the safest receiver, defenders keep their current facing.</li>
                <li><strong>Keyboard</strong> — <span class="keyhint">Enter</span> / <span class="keyhint">Space</span>
                    lock in · <span class="keyhint">Esc</span> pause · <span class="keyhint">M</span> mute ·
                    <span class="keyhint">R</span> restart match.</li>
                <li><strong>Shooting</strong> — a pass that lands within 30 units of goal becomes a shot, resolved
                    against the keeper.</li>
            </ul>

            <div class="actions">
                <button type="button" class="btn-primary" id="btn-tut-close">GOT IT</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-pause" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="pause-title">
            <div class="eyebrow">Paused</div>
            <h2 id="pause-title">Time out</h2>
            <p>The decision clock is paused too — it resumes exactly where it stopped.</p>

            <div class="actions">
                <button type="button" class="btn-primary" id="btn-resume">RESUME</button>
                <button type="button" class="btn-secondary" id="btn-restart">RESTART MATCH</button>
                <button type="button" class="btn-ghost-sm" id="btn-quit">QUIT TO MENU</button>
            </div>
        </div>
    </div>

    <div class="screen" id="screen-over" hidden>
        <div class="card" role="dialog" aria-modal="true" aria-labelledby="over-title">
            <div class="eyebrow">Full time</div>
            <h2 id="over-title">—</h2>
            <p id="over-detail"></p>

            <div class="actions">
                <button type="button" class="btn-primary" id="btn-again">PLAY AGAIN</button>
                <button type="button" class="btn-secondary" id="btn-menu">MAIN MENU</button>
            </div>
        </div>
    </div>

    <div id="err" role="alert"></div>

    <!-- Three.js r0.149.0 is bundled from node_modules by Vite (no CDN dependency). -->
    <script>
        import '../scripts/game-source.js';

        /* The engine's §4 self-test logs a console table and stashes the results
           on window.__GAP_VERIFY_RESULTS. Mirror that verdict into the menu card
           so it is legible without opening devtools — the engine stays the sole
           authority on pass/fail; this only renders what it reported.

           Registration order matters and is safe: importing the engine above
           synchronously installs its click handler first, so `out` is already
           populated by the time this listener runs. */
        const verifyOut = document.getElementById('verify-out');
        const verifyBtn = document.getElementById('btn-verify');

        if (verifyOut && verifyBtn) {
            verifyBtn.addEventListener('click', () => {
                const results = window.__GAP_VERIFY_RESULTS;
                if (!results) return;

                verifyOut.textContent = results
                    .map(r => (r.pass ? 'PASS  ' : 'FAIL  ') + r.name)
                    .join('\n');
                verifyOut.hidden = false;
            });
        }
    </script>
</body>

</html>
