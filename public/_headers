# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# This is THE source copy. It sits in Astro's publicDir, so `astro build` copies
# it verbatim to `out/_headers` — the upload root Cloudflare reads it from.
# tools/publish.mjs fails the build if it ever goes missing.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # Everything is first-party: Three.js is bundled from node_modules by Vite,
  # so there is no CDN in the script path. Google Fonts is the only external
  # origin (the Geist stylesheet, and the font files it points at).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.peerjs.com wss://*.peerjs.com https://0.peerjs.com wss://0.peerjs.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# The document is the entry point — never let an edge or browser cache it
# aggressively, so a redeploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite emits content-hashed filenames under /assets/, so those are safe to
# cache forever: a change produces a new name rather than a new body.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
